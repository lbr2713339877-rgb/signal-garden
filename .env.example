# ---------------------------------------------------------------------------
# Signal Garden — environment
# Copy to .env.local for development. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to use the local PGlite file database (./data/pg).
# Set it to a Postgres connection string in production.
# DATABASE_URL=postgres://user:pass@host:5432/signal_garden

# Local PGlite data directory (only used when DATABASE_URL is empty)
PGLITE_DIR=./data/pg

# --- GitHub (collectors) ----------------------------------------------------
# Classic PAT with public_repo scope is enough. Raises rate limit 60 -> 5000/hr.
GITHUB_TOKEN=

# --- Hacker News ------------------------------------------------------------
# Algolia search API needs no key. This is only an app identifier they ask for.
HN_USER_AGENT=signal-garden/0.1

# --- AI enrichment ----------------------------------------------------------
# Any OpenAI-compatible endpoint works, including relay/proxy stations.
# Base URL must include /v1. The client appends /chat/completions.
AI_BASE_URL=https://your-relay.example.com/v1
AI_API_KEY=
AI_MODEL=
# Optional: lower temperature keeps the summarizer close to its evidence.
AI_TEMPERATURE=0.2
# Hard ceiling on calls per run, so a runaway job cannot burn your credit.
AI_MAX_CALLS_PER_RUN=120

# --- Email (Phase 5, optional) ----------------------------------------------
# RESEND_API_KEY=
# DIGEST_FROM=signals@yourdomain.com

# --- Daily digest -----------------------------------------------------------
# The form stays hidden unless this is exactly "true". It is inlined at build time.
NEXT_PUBLIC_NEWSLETTER_ENABLED=false
# Mock transport unless both of these are set. Do not set live without a real key.
# NEWSLETTER_SEND_MODE=live
# RESEND_API_KEY=
# Set to "false" to make `pnpm job newsletter` record a skip and send nothing.
# NEWSLETTER_ENABLED=true
# From and Reply-To. Bare addresses get the Signal Garden display name.
# NEWSLETTER_FROM=Signal Garden <hello@signalgarden.site>
# NEWSLETTER_REPLY_TO=hello@signalgarden.site
# HMAC secret for long-lived unsubscribe links. Required when SEND_MODE=live.
# NEWSLETTER_UNSUB_SECRET=
# Optional pepper for consent IP hashes. A default is used when this is empty.
# NEWSLETTER_IP_HASH_SALT=
# Turnstile is skipped when the secret is empty.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Resend webhook signing secret. The webhook rejects requests when this is empty.
# RESEND_WEBHOOK_SECRET=

# --- App --------------------------------------------------------------------
# Production must be an https domain (no IP). Local may stay http for the site itself.
# MUST be an HTTPS production domain: email links and payment callbacks depend on it.
NEXT_PUBLIC_SITE_URL=https://signalgarden.site

# --- Supabase Auth ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (API only; no public checkout) ----------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- IndexNow ---------------------------------------------------------------
# Public key (not a secret). Served at https://<site>/<INDEXNOW_KEY>.txt.
# Leave empty to skip `pnpm job indexnow`.
# INDEXNOW_KEY=

# --- Visitor analytics ------------------------------------------------------
# One script, loaded only when SCRIPT_SRC is set. Empty means load nothing.
# NEXT_PUBLIC_ values are inlined at `next build`. See docs/visitor-analytics.md.
#
# Umami (self-hosted or cloud). WEBSITE_ID becomes data-website-id:
# NEXT_PUBLIC_ANALYTICS_SCRIPT_SRC=https://analytics.signalgarden.site/script.js
# NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
#
# Plausible classic later, if SRC points at that script. DATA_DOMAIN becomes
# data-domain. Do not invent a pa- script id.
# NEXT_PUBLIC_ANALYTICS_SCRIPT_SRC=https://plausible.io/js/script.js
# NEXT_PUBLIC_ANALYTICS_DATA_DOMAIN=signalgarden.site
NEXT_PUBLIC_ANALYTICS_SCRIPT_SRC=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
NEXT_PUBLIC_ANALYTICS_DATA_DOMAIN=
